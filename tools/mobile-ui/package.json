{
  "name": "dsh-mobile-ui",
  "version": "0.1.17",
  "private": true,
  "description": "Android-app-style mobile UI layer for the DeepSeek Harness Web interface: popup drawer sidebar, collapsed top-info panel, phone-adapted composer.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "node dev-proxy.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false
    }
  }
}
