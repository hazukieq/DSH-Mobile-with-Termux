# ~/.zshrc - DSH Mobile default config (v3)
# Managed by the app: this file is rewritten only while the version marker above
# is present. Delete/change that marker line to keep your own edits forever.
# Deliberately Termux-only: no PC aliases (nvm/pyenv/proxy/gcloud/texlive/...).

HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt append_history share_history inc_append_history hist_ignore_dups hist_ignore_space
setopt autocd extended_glob no_beep

# ---- 指令纠错（oh-my-zsh ENABLE_CORRECTION 的等价物，zsh 内建）----
# 拼错命令时提示 "correct 'lls' to 'lls'?"；不想被问就注释掉这一行。
setopt correct

# ---- 指令联想（内置 zsh-autosuggestions v0.7.1，无需 oh-my-zsh）----
# 依据历史输入给出灰色补全：→ / End 接受，Ctrl+E 接受整条。
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=242'
if [ -f ~/.dsh-mobile/zsh-autosuggestions.zsh ]; then
  source ~/.dsh-mobile/zsh-autosuggestions.zsh
fi

# completion
autoload -Uz compinit && compinit -D
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'l:|=* r:|=*'

# basic aliases
alias cls='clear'
alias ll='ls -l'
alias la='ls -a'
alias l='ls -CF'
alias vi='vim'
alias ..='cd ..'
alias ...='cd ../..'

# prompt: user@host:cwd
PROMPT='%F{cyan}%n%f@%F{green}%m%f:%F{blue}%~%f$ '
RPROMPT='%(?..%F{red}[%?]%f)'

export EDITOR=vi

# ---- 语法高亮（红=无效命令/拼写错误，绿=有效命令，青=路径；须放最后）----
if [ -f ~/.dsh-mobile/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
  source ~/.dsh-mobile/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
