#!/data/data/com.termux/files/usr/bin/bash
# [dsh-android] tar shim for dpkg-deb.
#
# dpkg-deb 解包 control 时会调用 GNU tar，并传 GNU 专有选项
# （`--warning=no-timestamp` 等）。Android 自带的是 toybox tar，不认这些选项，
# 于是 dpkg-deb 直接失败（"tar subprocess returned error exit status 1"）。
#
# 这里过滤掉 GNU 专有选项，其余参数原样交给 toybox tar（它在 proot 里可见：
# /system 被 bind 进 guest）。只用于 dpkg，不替代用户自己的 tar。
args=()
skip_next=0
for a in "$@"; do
  if [ "$skip_next" = "1" ]; then skip_next=0; continue; fi
  case "$a" in
    --warning=*|--no-same-owner|--no-same-permissions|--force-local|\
    --no-overwrite-dir|--no-recursion|--no-unquote|--no-ignore-case|\
    --no-anchored|--no-wildcards|--no-wildcards-match-slash|--ignore-case)
      ;;
    --exclude=*)
      args+=("$a")
      ;;
    *)
      args+=("$a")
      ;;
  esac
done
exec /system/bin/toybox tar "${args[@]}"
