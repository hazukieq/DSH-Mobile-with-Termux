#!/system/bin/sh
# docs — read the in-app detail documentation (v2.5.37)
# Usage:
#   docs                      list available docs
#   docs ACCESSIBILITY        print one doc (name, with or without .md)
#   docs DSH-MOBILE           (falls back to $DSH_HOME/DSH-MOBILE.md)
#   docs --toc DSH-MOBILE     list that doc's "## " headings
#   docs --section "Android powers" DSH-MOBILE
#                             print only that section (heading until the next "## ")
#   docs --grep "ownOverlay"  grep across every doc + DSH-MOBILE.md, with file:line
#   docs --path               print the docs directory
#   docs --fetch [ref]        pull the newest docs from the GitHub repo into $DSH_HOME/docs
#   docs --fetch --dry-run    only list what would change
# Docs live in $DSH_HOME/docs and are refreshed from the APK on app update;
# --fetch lets you update them without waiting for a new APK (the directory is
# inside the app sandbox, so writing it is allowed).
HERE=${0%/*}
. "$HERE/_dsh_http.sh" 2>/dev/null
DSH_HOME=${DSH_HOME:-$HOME}
DIR="$DSH_HOME/docs"
case "$1" in
  ""|--list|-l)
    if [ ! -d "$DIR" ]; then echo "docs: not deployed yet ($DIR)"; exit 1; fi
    echo "docs in $DIR:"
    for f in "$DIR"/*.md; do
      [ -f "$f" ] || continue
      printf '  %-26s %5s lines  %s\n' "$(basename "$f")" "$(wc -l < "$f")" "$(head -1 "$f" | cut -c1-60)"
    done
    if [ -d "$DIR/testing" ]; then
      echo "testing/:"
      for f in "$DIR"/testing/*.md; do [ -f "$f" ] && printf '  %-26s %5s lines\n' "testing/$(basename "$f")" "$(wc -l < "$f")"; done
    fi
    ;;
  --fetch|--fetch-docs|-F)
    # 从 GitHub 拉最新文档覆盖 $DSH_HOME/docs（App 私有空间，允许写）。
    # 走 GitHub API 列目录 + raw 下载单文件：约 22 个 ~40KB 请求，秒级完成，
    # 不用下整包 tarball（实测整包 100s+ 且吃流量）。
    # ref 可用参数或 DSH_DOCS_REF 指定（默认 main）；DSH_DOCS_REPO 可换 fork。
    ref="${DSH_DOCS_REF:-main}"
    dry=0
    _n=0
    for a in "$@"; do
      _n=$((_n+1))
      case "$a" in
        --dry-run|--dry) dry=1 ;;
        -*) ;;
        *) [ "$_n" -gt 1 ] && ref="$a" ;;
      esac
    done
    repo="${DSH_DOCS_REPO:-hazukieq/DSH-Mobile-with-Termux}"
    curl_bin="$(command -v curl 2>/dev/null || echo "$PREFIX/bin/curl")"
    if [ ! -x "$curl_bin" ]; then echo "docs: curl not found (pkg install curl)"; exit 1; fi
    [ -d "$DIR" ] || mkdir -p "$DIR" || { echo "docs: cannot create $DIR"; exit 1; }
    work="$DIR/.fetch-tmp"
    rm -rf "$work" 2>/dev/null; mkdir -p "$work" || exit 1

    list="$work/list.json"
    if ! "$curl_bin" -fsSL --max-time 30 \
        -H 'Accept: application/vnd.github+json' \
        "https://api.github.com/repos/$repo/contents/docs?ref=$ref" -o "$list"; then
      echo "docs: 列目录失败（repo=$repo ref=$ref；网络或 ref 不存在，或 GitHub API 限流）"
      echo "      可稍后重试，或只同步单篇：docs <NAME> 仍在本地"
      rm -rf "$work" 2>/dev/null; exit 1
    fi
    names=$(grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*\.md"' "$list" | sed 's/.*"\([^"]*\)"$/\1/' | sort -u)
    [ -n "$names" ] || { echo "docs: 该 ref 下 docs/ 没有 .md"; rm -rf "$work" 2>/dev/null; exit 1; }

    # 并发下载（22 个文件串行在弱网下要 2 分钟，并发后 5–10 秒）
    for b in $names; do
      ( "$curl_bin" -fsSL --max-time 40 \
          "https://raw.githubusercontent.com/$repo/$ref/docs/$b" -o "$work/$b" \
          || : > "$work/$b.fail" ) &
    done
    wait
    # 弱网下偶发 TLS/eof 失败：失败的重试一次（串行，代价小）
    for b in $names; do
      [ -f "$work/$b.fail" ] || continue
      : > "$work/$b.retry"
      "$curl_bin" -fsSL --max-time 40 \
        "https://raw.githubusercontent.com/$repo/$ref/docs/$b" -o "$work/$b" \
        && rm -f "$work/$b.fail" 2>/dev/null
    done

    new=0; upd=0; same=0; fail=0; files=""
    for b in $names; do
      files="$files $b"
      if [ -f "$work/$b.fail" ] || [ ! -s "$work/$b" ]; then
        echo "  ! $b 下载失败"; fail=$((fail+1)); continue
      fi
      if [ ! -f "$DIR/$b" ]; then new=$((new+1)); echo "  + $b"; [ "$dry" = 1 ] || cp -f "$work/$b" "$DIR/$b"
      elif cmp -s "$work/$b" "$DIR/$b"; then same=$((same+1))
      else upd=$((upd+1)); echo "  ~ $b"; [ "$dry" = 1 ] || cp -f "$work/$b" "$DIR/$b"; fi
    done
    rm -rf "$work" 2>/dev/null
    if [ "$dry" = 1 ]; then
      echo "docs: dry-run — 新增 $new / 更新 $upd / 未变 $same${fail:+ / 失败 $fail}（未写入）"
    else
      echo "docs: 已从 $repo@$ref 同步 — 新增 $new / 更新 $upd / 未变 $same${fail:+ / 失败 $fail}"
      stale=""
      for f in "$DIR"/*.md; do
        [ -f "$f" ] || continue
        b="$(basename "$f")"
        case " $files " in *" $b "*) ;; *) stale="$stale $b" ;; esac
      done
      [ -n "$stale" ] && echo "docs: 仓库里已没有（未删除，需要的话手动清）:$stale"
      echo "docs: 位置 $DIR"
    fi
    ;;
  --path|-p) echo "$DIR" ;;
  --toc|-t)
    n=${2:-}
    if [ -z "$n" ]; then
      for f in "$DIR"/*.md "$DSH_HOME/DSH-MOBILE.md"; do
        [ -f "$f" ] || continue
        echo "== $(basename "$f")"
        grep -n '^## ' "$f" | sed 's/^/  /'
      done
      exit 0
    fi
    case "$n" in *.md) ;; *) n="$n.md" ;; esac
    f="$DIR/$n"; [ -f "$f" ] || f="$DSH_HOME/$n"
    [ -f "$f" ] || { echo "docs: no such doc: $2"; exit 1; }
    echo "== $f"; grep -n '^## ' "$f"
    ;;
  --section|-s)
    want=$2; n=${3:-DSH-MOBILE}
    [ -n "$want" ] || { echo "docs: --section needs a heading substring"; exit 1; }
    case "$n" in *.md) ;; *) n="$n.md" ;; esac
    f="$DIR/$n"; [ -f "$f" ] || f="$DSH_HOME/$n"
    [ -f "$f" ] || { echo "docs: no such doc: $n"; exit 1; }
    awk -v want="$want" '
      BEGIN { IGNORECASE = 1; on = 0 }
      /^## / { if (on) exit; if (tolower($0) ~ tolower(want)) { on = 1 } }
      on { print }
    ' "$f"
    ;;
  --grep|-g)
    # grep 语义：默认 ERE 正则、区分大小写、输出 file:line:text（可用 -i/-F/-l/-c 修饰）
    _i=0; _F=0; _l=0; _c=0; pat=""
    shift
    for a in "$@"; do
      case "$a" in
        -i) _i=1 ;;
        -F) _F=1 ;;
        -l) _l=1 ;;
        -c) _c=1 ;;
        *)  [ -z "$pat" ] && pat="$a" ;;
      esac
    done
    [ -n "$pat" ] || { echo "docs: --grep needs a pattern (grep semantics: ERE, case-sensitive; flags -i -F -l -c)"; exit 1; }
    _opts="-n"
    [ "$_i" = 1 ] && _opts="$_opts -i"
    [ "$_F" = 1 ] && _opts="$_opts -F" || _opts="$_opts -E"
    [ "$_l" = 1 ] && _opts="$_opts -l"
    [ "$_c" = 1 ] && _opts="$_opts -c"
    # shellcheck disable=SC2086
    _out=$(grep $_opts -- "$pat" "$DIR"/*.md "$DSH_HOME/DSH-MOBILE.md" 2>&1)
    _rc=$?
    if [ "$_rc" -ge 2 ]; then echo "docs: grep error: $_out"; exit 2; fi
    printf '%s\n' "$_out" | head -60
    ;;
  *)
    n=$1
    case "$n" in *.md) ;; *) n="$n.md" ;; esac
    f="$DIR/$n"
    [ -f "$f" ] || f="$DIR/testing/$n"
    [ -f "$f" ] || f="$DSH_HOME/$n"
    if [ ! -f "$f" ]; then echo "docs: no such doc: $1"; exit 1; fi
    cat "$f"
    ;;
esac
