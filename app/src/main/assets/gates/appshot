#!/system/bin/sh
# [dsh-android] 自举到引擎 bash（/dev/tcp 是 bash 特性，toybox sh 不支持）。
if [ -z "$_DSH_REEXEC" ]; then
  _DSH_REEXEC=1; export _DSH_REEXEC
  LD_LIBRARY_PATH="@DSH_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; export LD_LIBRARY_PATH
  exec "@DSH_BASH@" "$0" "$@"
fi
# [dsh-android] appshot: native screenshot of DSH Mobile's own window (v1.3.24).
# usage: appshot [--max N] [--out /path/file.png]
#   Uses PixelCopy on the app window (no accessibility needed; WebView pixels included).
#   Requires the DSH Mobile UI to be in the foreground.
DIR=$(cd "$(dirname "$0")" && pwd)
. "$DIR/_dsh_http.sh"

MAX=1280
OUT=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --max) shift; MAX="${1:-1280}" ;;
    --out) shift; OUT="${1:-}" ;;
    -h|--help) echo "usage: appshot [--max N] [--out /path.png]"; exit 0 ;;
    *) echo "appshot: unknown argument '$1'" >&2; exit 2 ;;
  esac
  shift
done

out=$(dsh_http GET "/app-screenshot?max=$MAX")
rc=$?
[ "$rc" = 0 ] || { echo "appshot: bridge failed (rc=$rc)${out:+ — $out}" >&2; exit 1; }
printf '%s\n' "$out"
if [ -n "$OUT" ]; then
  src=$(printf '%s' "$out" | sed -n 's/.*"path":"\([^"]*\)".*/\1/p')
  if [ -n "$src" ] && [ -f "$src" ]; then
    cp -f "$src" "$OUT" && echo "copied: $OUT"
  else
    echo "appshot: could not locate saved screenshot" >&2
    exit 1
  fi
fi
exit 0
