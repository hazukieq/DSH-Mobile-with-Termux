#!/system/bin/sh
# [dsh-android] 自举到引擎 bash（/dev/tcp 是 bash 特性，toybox sh 不支持）。
if [ -z "$_DSH_REEXEC" ]; then
  _DSH_REEXEC=1; export _DSH_REEXEC
  LD_LIBRARY_PATH="@DSH_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; export LD_LIBRARY_PATH
  exec "@DSH_BASH@" "$0" "$@"
fi
# [dsh-android] native: App 原生控制/调试 API 的快捷入口（v1.3.30）。
#
# usage:
#   native status                    App/引擎/联网/电量/内存/存储/屏幕/权限 总览
#   native settings                  读取原生设置当前值
#   native set key=value [key=value…] 写入原生设置（数字/布尔自动识别）
#   native open settings|terminal|main|overlay-settings|accessibility-settings [--notify]
#                                    打开 App 自己的页面；回执含 opened / background_blocked
#                                    （后台启动被 BAL 拦截时会明确报 opened:false，--notify 可发通知兜底）
#   native net                       只取联网状态（status 的子集，原始 JSON）
#   native files                     检查 $PREFIX/bin 里 App 管理的脚本：真实文件/可执行/符号链接
#   native json <GET|POST> <path> [body]  直接调 AgentBridge（token 自动带）
#
# 例：native open settings && native set page_scale=100 orientation=auto
DIR=$(cd "$(dirname "$0")" && pwd)
. "$DIR/_dsh_http.sh"

usage() { sed -n '9,22p' "$0" >&2; exit 2; }

json_or_die() {
  out=$(dsh_http "$1" "$2" "$3")
  rc=$?
  [ "$rc" = 0 ] || { echo "native: bridge failed (rc=$rc)${out:+ — $out}" >&2; exit 1; }
  printf '%s\n' "$out"
}

case "${1:-}" in
  status) shift; json_or_die GET /status ;;
  settings|get) shift; json_or_die GET /settings ;;
  net)
    out=$(dsh_http GET /status); rc=$?
    [ "$rc" = 0 ] || { echo "native: bridge failed (rc=$rc)" >&2; exit 1; }
    printf '%s\n' "$out" | sed -n 's/.*"net":\({[^}]*}\).*/\1/p'
    ;;
  open)
    page=""; notify="false"
    shift
    for a in "$@"; do
      case "$a" in
        --notify) notify="true" ;;
        -*) echo "native open: unknown flag '$a'" >&2; exit 2 ;;
        *) page="$a" ;;
      esac
    done
    [ -n "$page" ] || usage
    json_or_die POST /activity "{\"name\":\"$(printf '%s' "$page" | sed 's/"/\\"/g')\"$([ "$notify" = true ] && printf ',')$( [ "$notify" = true ] && printf '\"notifyIfBlocked\":true' )}"
    ;;
  set|write)
    shift
    pairs=""
    for kv in "$@"; do
      k=${kv%%=*}; v=${kv#*=}
      [ "$k" != "$kv" ] || { echo "native set: want key=value, got '$kv'" >&2; exit 2; }
      case "$v" in
        true|false) jv="$v" ;;
        out-of-range) jv="$v" ;;
        ''|*[!0-9.-]*) jv="\"$(printf '%s' "$v" | sed 's/\\/\\\\/g; s/"/\\"/g')\"" ;;
        *) jv="$v" ;;
      esac
      [ -n "$pairs" ] && pairs="$pairs,"
      pairs="$pairs\"$k\":$jv"
    done
    json_or_die POST /settings "{\"set\":{$pairs}}"
    ;;
  files|perms|doctor)
    # 检查 App 管理的脚本是否真实文件且可执行（v1.3.34，排查「command not found / Permission denied」）
    PREFIX=${PREFIX:-/data/data/com.termux/files/usr}
    BIN="$PREFIX/bin"
    bad=0
    for n in _dsh_http.sh notify scr say psx killx loop fast linux dsh-update shot appshot alarm record native dsh-mobile rm trash-cli; do
      f="$BIN/$n"
      if [ ! -e "$f" ]; then echo "MISSING   $n"; bad=$((bad+1)); continue; fi
      if [ -L "$f" ]; then echo "SYMLINK   $n -> $(readlink "$f")"; bad=$((bad+1)); continue; fi
      if [ ! -x "$f" ]; then echo "NOT-EXEC  $n ($(ls -l "$f" | awk '{print $1}'))"; bad=$((bad+1)); continue; fi
      echo "ok        $n"
    done
    [ "$bad" = 0 ] && echo "--- all managed scripts are real files and executable" || echo "--- $bad problem(s); the app repairs modes/symlinks on next start"
    ;;
  json)
    m="${2:-}"; p="${3:-}"; b="${4:-}"
    [ -n "$m" ] && [ -n "$p" ] || usage
    json_or_die "$m" "$p" "$b"
    ;;
  -h|--help|help|"") usage ;;
  *) echo "native: unknown command '$1'" >&2; usage ;;
esac
