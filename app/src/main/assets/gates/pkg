#!/system/bin/sh
# [dsh-android] pkg: real package manager for the native runtime.
#
# 这是一个**真**包管理器前端：Termux 官方仓库 + 交叉编译的 dpkg + proot 前缀映射。
#   · .deb 内部路径是 /data/data/com.termux/files/usr/...，proot 把该前缀 bind 到
#     本 App 的引擎目录 → 文件落在正确位置，维护脚本的 shebang 也能跑；
#   · dpkg 本体是按 app.dsh.mobile 前缀重编的，状态库在 <engine>/var/lib/dpkg；
#   · 依赖解析/下载/校验由 engine/bin/pkg.js（node）完成。
#
# 用法:
#   pkg update                刷新仓库索引（Packages.gz）
#   pkg install <pkg...>      安装（含依赖解析；Termux 仓库的 arm64/x86_64 包）
#   pkg remove <pkg...>       卸载
#   pkg list                  已装列表（读 dpkg 状态库）
#   pkg search <关键词>       搜仓库
#   pkg info <pkg>            仓库元数据
#   pkg help
#
# 另一条装包路：App 扩展（pkg install 的等价物之一）由扩展中心管理；
# 需要完整发行版（apt/apk 生态）时用 `linux shell alpine|ubuntu`。
DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
# node/openssl 的 OpenSSL 默认配置路径是编译期写死的 com.termux 前缀；引擎环境
# 平时会注入 OPENSSL_CONF，但精简环境（env -i、某些子进程）里没有 → node 一启动
# 就报 "OpenSSL configuration error: Permission denied"。这里兜底。
if [ -z "${OPENSSL_CONF:-}" ] && [ -f "$DIR/../etc/tls/openssl.cnf" ]; then
  OPENSSL_CONF="$DIR/../etc/tls/openssl.cnf"; export OPENSSL_CONF
fi
if [ -z "${SSL_CERT_FILE:-}" ] && [ -f "$DIR/../etc/tls/cert.pem" ]; then
  SSL_CERT_FILE="$DIR/../etc/tls/cert.pem"; export SSL_CERT_FILE
fi
NODE="$DIR/node"
PKGJS="$DIR/pkg.js"
if [ ! -x "$NODE" ]; then
  echo "pkg: engine node not found at $NODE" >&2
  exit 3
fi
if [ ! -f "$PKGJS" ]; then
  echo "pkg: pkg.js missing at $PKGJS (runtime overlay not deployed?)" >&2
  exit 3
fi
exec "$NODE" "$PKGJS" "$@"
