#!@DSH_BASH@
# [dsh-android] desktop bridge: 把任务派给电脑端 dsh（headless profile），取回结果。
#
# 通道：电脑侧 `~/.dsh/usb-bridge/bridge.mjs` 监听 127.0.0.1:9100，
# 再由电脑执行 `adb reverse tcp:9100 tcp:9100`，手机 127.0.0.1:9100 即电脑服务。
# 依赖 USB 调试连接；断开后 `pc` 会报连接失败，需要电脑侧重新 attach。
#
# 用法:
#   pc health                      # 桥是否在线、队列状态
#   pc ask "任务描述"              # 派发并等待，打印电脑端的最终回复
#   pc start "任务描述"            # 只派发，打印 task id（随后用 pc show <id>）
#   pc show <id>                   # 查看状态 + 结果（可反复查看）
#   pc list                        # 最近任务摘要
#   pc cancel <id>                 # 取消排队/运行中的任务
#   pc session <session-id> "任务" # 续用电脑端某个 headless 会话
set -u
BASE="${PC_BRIDGE_URL:-http://127.0.0.1:9100}"
ROOT="${PREFIX:-/data/data/com.termux/files/usr}"
CURL="${ROOT}/bin/curl"
NODE="${ROOT}/bin/node"
WAIT_SECS="${PC_WAIT_SECS:-600}"

die() { echo "pc: $*" >&2; exit 1; }
[ -x "$CURL" ] || CURL="$(command -v curl)" || die "curl not found"
[ -x "$NODE" ] || NODE="$(command -v node)" || die "node not found"

json_get() { "$NODE" -e '
let s=""; process.stdin.on("data",d=>s+=d).on("end",()=>{
  let o; try { o=JSON.parse(s) } catch (e) { console.error("pc: bad JSON from bridge: "+s.slice(0,300)); process.exit(2) }
  const path=process.argv[1].split("."); let v=o;
  for (const k of path) { if (v==null) break; v=v[k] }
  process.stdout.write(v==null?"":String(v));
});' "$1"; }

req() { # method path [json]
  local m="$1" p="$2" b="${3:-}"
  if [ -n "$b" ]; then
    "$CURL" -s -m 15 -X "$m" "$BASE$p" -H 'content-type: application/json' -d "$b"
  else
    "$CURL" -s -m 15 -X "$m" "$BASE$p"
  fi
}

json_escape() { "$NODE" -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>process.stdout.write(JSON.stringify(s)))'; }

print_task() { # 从 stdin 读 JSON
  local out
  out=$("$NODE" -e '
let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{
  const t=JSON.parse(s);
  const head=`[${t.state}] id=${t.id} exit=${t.exit??"-"} ms=${t.ms??"-"}`;
  let body=(t.stdout||"").trim(); const err=(t.stderr||"").trim();
  if (!body && err) body=err;
  process.stdout.write(head+"\n"+body+"\n");
});')
  printf '%s\n' "$out"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  health)
    req GET /health | "$NODE" -e '
let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const h=JSON.parse(s);
process.stdout.write(`ok=${h.ok} running=${h.running||"-"} queued=${h.queued} tasks=${h.tasks} results=${h.results}\n`)})' ;;
  list)
    req GET /tasks | "$NODE" -e '
let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const h=JSON.parse(s);
(h.tasks||[]).forEach(t=>process.stdout.write(`[${t.state}] ${t.id} ${t.task.slice(0,80)}\n`))})' ;;
  start|ask|session)
    if [ "$cmd" = session ]; then
      sid="${1:-}"; shift || true; [ -n "$sid" ] || die "usage: pc session <session-id> <task>"
      task="$*"
    else
      task="$*"
    fi
    [ -n "${task:-}" ] || die "usage: pc $cmd <task>"
    payload="{\"task\":$(printf '%s' "$task" | json_escape)${sid:+,\"sessionId\":\"$sid\"}}"
    resp=$(req POST /task "$payload") || die "bridge unreachable (USB reverse not attached?)"
    id=$(printf '%s' "$resp" | json_get id)
    [ -n "$id" ] || { printf '%s\n' "$resp"; die "submit failed"; }
    if [ "$cmd" = start ]; then
      echo "queued: $id"
      echo "check with: pc show $id"
      exit 0
    fi
    echo "pc: queued $id, waiting (up to ${WAIT_SECS}s)…" >&2
    deadline=$(( $(date +%s) + WAIT_SECS ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
      sleep 1
      st=$(req GET "/task/$id") || { echo "pc: lost bridge while waiting" >&2; printf 'id=%s\n' "$id"; exit 2; }
      state=$(printf '%s' "$st" | json_get state)
      case "$state" in
        done|failed|cancelled) printf '%s' "$st" | print_task; exit 0 ;;
      esac
    done
    echo "pc: timeout after ${WAIT_SECS}s; task still running, id=$id" >&2
    echo "check later with: pc show $id"
    exit 3 ;;
  show)
    id="${1:-}"; [ -n "$id" ] || die "usage: pc show <id>"
    req GET "/task/$id" | print_task ;;
  cancel)
    id="${1:-}"; [ -n "$id" ] || die "usage: pc cancel <id>"
    req POST "/task/$id/cancel" | print_task ;;
  *)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit 0 ;;
esac
