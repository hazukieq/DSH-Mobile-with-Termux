#!/system/bin/sh
# [dsh-android] dsh-update: 热更新 **dsh 引擎层**（不重装 APK、不动 Termux 基础环境）。
#
# 背景（2026-10-18 包名切到 com.termux 之后，架构是两层的）：
#   <files>/usr            = Termux 官方 bootstrap（apt/dpkg/bash/coreutils…）
#   <files>/usr/lib/node_modules/@deepseek-ai/dsh   = 适配版 dsh 引擎
#   <files>/usr/bin/node、bin/rg                    = 引擎依赖
#
# 所以「热更新」= 换掉 **引擎层那几项**（lib/node_modules / bin/node / bin/rg /
# .dsh-engine-version），bootstrap 一个文件都不碰。跟老版本一样按 **dsh 版本**判断，
# 不按 APK 版本；产物是预先打好 Android 适配补丁的 engine tar.gz。
#
# 用法:
#   dsh-update status                       本地 dsh/node/引擎版本、暂存与回滚状态
#   dsh-update check [--manifest URL]       本地 dsh 版本 vs **GitHub** 上的最新引擎（不经 npm）
#   dsh-update pull [dsh-version] [--apply] 下载最新引擎包并暂存（--apply 直接切换）
#   dsh-update stage <url|path> [sha256]    暂存指定引擎包（离线测试用）
#   dsh-update apply                        备份当前引擎 → 换入暂存 → 重启 + 健康检查
#   dsh-update rollback                     回滚到上一份引擎
#   dsh-update restart                      只重启引擎
#   dsh-update version                      同 status
#   dsh-update howto                        打印「自己编译上游 dsh」的完整步骤
#
# 自己编译 / 自建引擎层（想用比 Release 更新的 dsh，或自己改引擎代码时）：
#   本 App 的引擎层 = Termux 版 node + 上游 dsh 的依赖闭包 + 一组 Android 兼容
#   补丁。所以「编译」= 在主机上重新组装，不是手机上 gcc；**但手机自己也能装
#   （手机端自建 ≈2–3 分钟，见下面 6)）**。
#
#   0) 选版本：必须是上游 tag，例如 dsh-v0.2.2-alpha.2（不是 npm 的 dist-tag）。
#   1) 主机准备：node/npm(>=20)、pnpm、unzip、zip、python3、llvm-readelf（NDK）
#        export NPM_REGISTRY=https://registry.npmmirror.com        # npm 换源
#        export TERMUX_REPO=https://mirror.nju.edu.cn/termux/apt/termux-main
#      ⚠️ Termux 源：NJU 最快（实测 ~521 kB/s），USTC 可用，TUNA/BFSU 的 termux
#         路径会 403。npmmirror 约 1.5 MB/s。
#   2a) 【快路】只换 JS 闭包、复用现有运行时（升级 dsh 版本首选，20 秒出包）：
#        先按上游 packaging 产「发布形态闭包」（详见 docs/ENGINE-BUILD.md §1）：
#          pnpm exec tsx scripts/release/pack.ts --family dsh --out /tmp/npmpack
#          npm install --ignore-scripts --omit=optional ...（tarball 走 file: 依赖）
#        然后：
#          scripts/build-engine-closure.sh \
#              --engine app/src/main/assets/engine-dsh-aarch64.zip \
#              --closure /tmp/release-consumer/node_modules \
#              --version "0.2.2-alpha.2+src1" --out /tmp/engine-closure.tar.gz
#        它会换 lib/node_modules → 调 scripts/patch-engine-closure.sh 打补丁 →
#        三道自检（cosmokit / 无 workspace: / require cordis）→ 打最小布局 tar。
#      ⚠️ 闭包必须是发布形态：monorepo 的 node_modules 会留 workspace: 且缺
#         cosmokit，装上后引擎 exit=1。
#   2b) 【全量路】连运行时一起收（首次或换 Termux 包时；会打 koffi 打桩 /
#      session-persistence / flock 等 bionic 兼容补丁）：
#        DSH_VERSION=0.2.2-alpha.2 scripts/collect-termux-runtime.sh /tmp/rt-arm64.zip aarch64
#      ⚠️ 跳过这一步 = 白屏或引擎起不来，不要试图用 npm 包替代。
#   3) 组装引擎层（产物布局与热更新包一致，可直接 stage）：
#        scripts/build-engine-layer.sh --runtime /tmp/rt-arm64.zip --arch aarch64 \
#            --out /tmp/engine-mine --engine-version "0.2.2-alpha.2+my1"
#      产物：/tmp/engine-mine/engine-dsh-aarch64.tar.gz（另有 .zip 与 manifest）；
#      脚本会顺手用 scripts/verify-runtime-abi.py 校验 ABI。
#   4) 引擎 tar 的**最小可用布局**（自己手搓包时必须满足）：
#        lib/node_modules/**          必须（dshEntry 走 npm 布局解析）
#        .dsh-engine-version          必须（status/回滚识别）
#        bin/node、bin/rg             可选；缺了会沿用旧引擎/运行时的那份
#      ⚠️ 不要把 runtime.zip 直接当引擎包 stage —— 它没有 lib/node_modules，只会
#         把引擎换成「空壳」。
#   5) 推进手机：
#        adb push /tmp/engine-mine/engine-dsh-aarch64.tar.gz /sdcard/Download/
#        sha256sum /tmp/engine-mine/engine-dsh-aarch64.tar.gz   # 取哈希
#        dsh-update stage /sdcard/Download/engine-dsh-aarch64.tar.gz <sha256>
#        dsh-update apply        # 换引擎 → 等旧进程退出 → 健康检查；失败自动回滚
#        dsh-update rollback     # 随时回上一份
#      apply 现在会先确认「旧引擎 pid 已消失/已换新 pid」再判健康，避免旧引擎的
#      401 冒充健康导致回滚不触发。
#   6) 手机端自建（可选，适合没有主机时；需 Termux 内 php? 不需要）：
#        pkg install -y git zip tar              # 别装 nodejs/pnpm：会覆盖 App 的 wrapper
#        （被打补丁脚本在仓库 scripts/ 里，需要 git clone 本仓库）
#        cd ~ && git clone --depth 1 --branch dsh-v0.2.2-alpha.2 \
#            https://github.com/deepseek-ai/deepseek-harness.git dhs
#        cd dhs && pnpm install --frozen-lockfile && pnpm build:official
#        # 再把 lib/node_modules 闭包 + .dsh-engine-version 打 tar 后 stage/apply
#      手机端慢在 pnpm install 与构建（10–15 分钟，内存吃紧时给 node 加
#      --max-old-space-size=4096），好处是完全离线可控。
#   7) 版本号只用于 status/回滚识别，建议 "<上游版本>+<你的标记>"。
#
# 退出码: 0 成功 / 1 失败或被拒 / 2 用法错误 / 3 环境错误
#
# 自举到引擎 bash（同 notify/linux 等门脚本）：shebang 不传环境变量。
if [ -z "$_DSH_REEXEC" ]; then
  _DSH_REEXEC=1; export _DSH_REEXEC
  LD_LIBRARY_PATH="@DSH_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; export LD_LIBRARY_PATH
  exec "@DSH_BASH@" "$0" "$@"
fi

DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
P="${PREFIX:-$(cd "$DIR/.." 2>/dev/null && pwd)}"
STAGED="$P/.engine-staged"
PREV="$P/.engine-prev"
MANIFEST_DEFAULT="https://github.com/Soodok/Deepseek-Harness-Local-Android/releases/download/dsh-engine-latest/engine-manifest.json"
HEALTH_URL="http://127.0.0.1:3080/"

_die() { echo "dsh-update: $*" >&2; exit "${_EXIT:-3}"; }
_usage() { sed -n '3,80p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# ── 版本读取 ────────────────────────────────────────────────────────────────
_dsh_version() {
  local pkg="$P/lib/node_modules/@deepseek-ai/dsh/package.json"
  [ -f "$pkg" ] || { echo "?"; return 1; }
  if [ -x "$P/bin/node" ]; then
    "$P/bin/node" -e 'try{process.stdout.write(require(process.argv[1]).version||"?")}catch(e){process.stdout.write("?")}' "$pkg" 2>/dev/null
  else
    sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$pkg" | head -1
  fi
}
_engine_version() { [ -f "$P/.dsh-engine-version" ] && cat "$P/.dsh-engine-version" || echo "?"; }
_node_version() { [ -x "$P/bin/node" ] && "$P/bin/node" --version 2>/dev/null || echo "?"; }

# ── feed ───────────────────────────────────────────────────────────────────
_ABI=unknown
case "$(uname -m)" in aarch64|arm64) _ABI=aarch64 ;; x86_64|amd64) _ABI=x86_64 ;; arm*) _ABI=arm ;; esac

_jget() {  # $1=json $2=key → 第一个字符串值（只适用于我们自己的扁平面量）
  printf '%s' "$1" | sed -n "s/.*\"$2\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" | head -1
}
_jabi() {  # 取 assets 里本 abi 的 url/sha（格式固定：先 url 后 sha256）
  printf '%s' "$1" | tr ',' '\n' | sed -n "/\"$_ABI\"/,/sha256/p" | sed -n 's/.*"url"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}
_jabisha() {
  printf '%s' "$1" | tr '}' '\n' | sed -n "/\"$_ABI\"/p" | sed -n 's/.*"sha256"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1
}

_GH_API="https://api.github.com/repos/Soodok/Deepseek-Harness-Local-Android"
# 上游 dsh 项目本体（官方 GitHub）：release tag 形如 dsh-v0.2.1-rc.2
_GH_UPSTREAM_API="https://api.github.com/repos/deepseek-ai/deepseek-harness"

# 查上游最新 dsh 版本（只查 GitHub，不查 npm）
_upstream_latest() {
  curl -fsSL -m 25 -H 'Accept: application/vnd.github+json' \
    "$_GH_UPSTREAM_API/releases?per_page=20" 2>/dev/null \
    | tr ',' '\n' \
    | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"dsh-v\([^"]*\)".*/\1/p' \
    | head -1
}

_fetch_manifest() {  # $1=url|path → 内容
  case "$1" in
    http://*|https://*) command -v curl >/dev/null 2>&1 || _die "curl not found"; curl -fsSL --retry 2 -m 60 "$1" ;;
    *) [ -f "$1" ] || _die "manifest not found: $1"; cat "$1" ;;
  esac
}

# 官方 feed 只走 GitHub（不查 npm）：
#   1. 滚动 release 的直链 engine-manifest.json（dsh-engine-latest）
#   2. 直链还没同步/还没发布时，用 GitHub Releases API 在最近 30 个 release 里
#      找一个挂了 engine-manifest.json 资产的，按 API 给的 browser_download_url 取
_feed_manifest() {
  local json url
  json=$(_fetch_manifest "$MANIFEST_DEFAULT" 2>/dev/null) && { printf '%s' "$json"; return 0; }
  command -v curl >/dev/null 2>&1 || return 1
  json=$(curl -fsSL -m 30 -H 'Accept: application/vnd.github+json' "$_GH_API/releases?per_page=30" 2>/dev/null) || return 1
  url=$(printf '%s' "$json" | tr ',' '\n' | sed -n 's/.*"browser_download_url"[[:space:]]*:[[:space:]]*"\([^"]*engine-manifest\.json\)".*/\1/p' | head -1)
  [ -n "$url" ] || return 1
  _fetch_manifest "$url"
}

# ── 引擎层操作 ───────────────────────────────────────────────────────────────
_restart_engine() {
  local delay_ms="${1:-400}"
  # v1.7.1：优先调用 **App 提供的受控重启**（AgentBridge POST /engine/restart
  # → EngineSupervisor.restart()）。旧实现直接 pkill，属于非受控重启：token/WebView
  # 重载时序不可控，也容易和外部进程抢端口。
  #
  # 关键：重启会杀掉**调用方自己**（门脚本跑在引擎进程里），所以这里让 App
  # 延迟执行重启（默认 8s），命令先把结果打印出来、agent 先回复，再真正停引擎。
  local helper="$DIR/_dsh_http.sh"
  if [ -r "$helper" ]; then
    # shellcheck disable=SC1090
    . "$helper"
    local body="{\"delayMs\":$delay_ms}"
    if dsh_http POST /engine/restart "$body" >/dev/null 2>&1; then
      if [ "$delay_ms" -gt 0 ]; then
        echo "restart: scheduled via app supervisor in $((delay_ms / 1000))s (current turn will be interrupted)"
        echo "restart: the engine will stop/start by itself; do not run another restart"
      else
        echo "restart: requested via app supervisor (POST /engine/restart)"
      fi
      return 0
    fi
    echo "restart: bridge restart failed; falling back to supervisor-less kill" >&2
  else
    echo "restart: http helper missing ($helper)" >&2
  fi
  pkill -f "$P/bin/node" 2>/dev/null || true
  echo "restart: engine killed; waiting for the app guardian"
}
_engine_pid() {
  pgrep -f "lib/dsh-engine/node-bin" 2>/dev/null | head -1 \
    || pgrep -f "lib/bin.js" 2>/dev/null | head -1 \
    || true
}

# 等「旧引擎真的被换掉」再判健康。
# 为什么需要：受控重启是 App 延迟执行的（_restart_engine 立即返回），如果直接
# _wait_healthy，探测到的还是**旧引擎**的 401，于是新引擎起不来也会被判成 ok，
# 回滚永远不触发。
_wait_restarted() {  # $1=秒 $2=旧 pid
  local limit="$1" old="$2" start=$SECONDS pid
  while [ $((SECONDS - start)) -lt "$limit" ]; do
    pid=$(_engine_pid)
    if [ -z "$pid" ]; then
      echo "restart: engine stopped (was $old), waiting for it to come back"
      return 0
    fi
    if [ -n "$old" ] && [ "$pid" != "$old" ]; then
      echo "restart: engine pid $old -> $pid"
      return 0
    fi
    sleep 1
  done
  echo "restart: engine did not restart within ${limit}s (pid still $old)" >&2
  return 1
}

_wait_healthy() {  # $1=秒
  local limit="$1" start=$SECONDS code
  while [ $((SECONDS - start)) -lt "$limit" ]; do
    code=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "$HEALTH_URL" 2>/dev/null || true)
    case "$code" in 2*|3*|4*) echo "health: ok (http $code)"; return 0 ;; esac
    sleep 2
  done
  echo "health: failed (timeout ${limit}s)" >&2
  return 1
}

_cmd_status() {
  echo "dsh: $(_dsh_version)"
  echo "node: $(_node_version)"
  echo "engine: $(_engine_version)"
  echo "prefix: $P"
  echo "staged: $([ -f "$STAGED/.dsh-engine-version" ] && cat "$STAGED/.dsh-engine-version" || echo none)"
  echo "rollback: $([ -f "$PREV/engine-version" ] && cat "$PREV/engine-version" || echo none)"
  exit 0
}

_cmd_check() {
  local manifest="$MANIFEST_DEFAULT" json local_v feed_v feed_e local_e
  while [ $# -gt 0 ]; do case "$1" in --manifest) manifest="$2"; shift 2 ;; *) _usage ;; esac; done
  local_v=$(_dsh_version); local_e=$(_engine_version)
  local up
  echo "dsh: $local_v"
  echo "engine: $local_e"
  echo "abi: $_ABI"
  up=$(_upstream_latest || true)
  echo "upstream_github: ${up:-unknown} (deepseek-ai/deepseek-harness)"
  local up_new=""
  [ -n "$up" ] && [ "$up" != "$local_v" ] && up_new=1
  if [ "$manifest" = "$MANIFEST_DEFAULT" ]; then json=$(_feed_manifest || true); else json=$(_fetch_manifest "$manifest" 2>/dev/null || true); fi
  if [ -n "${json:-}" ]; then
    feed_v=$(_jget "$json" dsh_version); feed_e=$(_jget "$json" engine_version)
    if [ "$manifest" = "$MANIFEST_DEFAULT" ]; then echo "feed: github (dsh-engine-latest)"; else echo "feed: $manifest"; fi
    echo "feed_dsh: ${feed_v:-?}"
    echo "feed_engine: ${feed_e:-?}"
    if [ -n "$feed_e" ] && [ "$feed_e" = "$local_e" ]; then
      echo "update: no (already $local_e)"; exit 0
    fi
    if [ -n "$feed_v" ] && [ "$feed_v" = "$local_v" ] && [ "${feed_e:-}" = "$local_e" ]; then
      echo "update: no (already $local_v / $local_e)"; exit 0
    fi
    echo "update: yes ($local_v/$local_e -> ${feed_v:-?}/${feed_e:-?})"
    exit 0
  fi
  # 官方 GitHub 上还没有带引擎包的 release：如实报告，不拿 npm 冒充
  echo "feed: unavailable (no release with engine-manifest.json on our repo yet)"
  if [ -n "$up_new" ]; then
    echo "update: yes upstream ($local_v -> $up; Android 适配引擎包尚未发布)"
    echo "hint: 上游已发新版，但本仓库的 dsh-engine-latest 还没有该版本；"
    echo "      可等 CI 构建，或直接用包含新引擎的 APK 升级。"
  else
    echo "hint: 引擎热更新包由 .github/workflows/dsh-runtime.yml 发布到 dsh-engine-latest；"
    echo "      在它发布之前，升级引擎 = 安装包含新引擎的 APK。"
    echo "update: no (local $local_v matches upstream ${up:-unknown}; no adapted engine published)"
  fi
  exit 0
}

_cmd_stage() {
  local src="$1" sha="${2:-}" tmp="$P/tmp/engine-dsh.tar.gz"
  [ -n "$src" ] || _usage
  mkdir -p "$P/tmp"
  case "$src" in
    http://*|https://*) echo "stage: downloading $src"; curl -fL --retry 3 -m 900 -o "$tmp" "$src" || _die "download failed" ;;
    *) [ -f "$src" ] || _die "artifact not found: $src"; cp -f "$src" "$tmp" ;;
  esac
  if [ -n "$sha" ]; then
    local got; got=$(sha256sum "$tmp" | cut -d' ' -f1)
    [ "$got" = "$sha" ] || _die "sha256 mismatch (want $sha got $got)"
  fi
  rm -rf "$STAGED.new"; mkdir -p "$STAGED.new"
  tar -xzf "$tmp" -C "$STAGED.new" || _die "extract failed"
  [ -f "$STAGED.new/lib/node_modules/@deepseek-ai/dsh/lib/bin.js" ] || [ -f "$STAGED/lib/node_modules/@deepseek-ai/dsh/lib/bin.js" ] || _die "artifact is not a dsh engine bundle"
  rm -rf "$STAGED"; mv "$STAGED.new" "$STAGED"
  echo "stage: ok ($([ -f "$STAGED/.dsh-engine-version" ] && cat "$STAGED/.dsh-engine-version" || echo unknown))"
  exit 0
}

_swap_in() {  # $1 = staged 目录（引擎层）
  local s="$1" b
  rm -rf "$PREV"; mkdir -p "$PREV"
  # 备份旧的引擎层（每项独立，缺就跳过；用 cp 而不是 mv，避免目录嵌套时静默出错）
  [ -d "$P/lib/node_modules" ] && { mv "$P/lib/node_modules" "$PREV/node_modules" || _die "backup of node_modules failed (out of space?)" 1; }
  for b in node rg; do [ -f "$P/bin/$b" ] && cp -f "$P/bin/$b" "$PREV/bin-$b"; done
  [ -f "$P/.dsh-engine-version" ] && cp -f "$P/.dsh-engine-version" "$PREV/engine-version"
  # 换入新层（旧层已 mv 到 PREV，这里目标必然不存在）
  rm -rf "$P/lib/node_modules"
  mv "$s/lib/node_modules" "$P/lib/node_modules" || _die "swap failed: cannot move staged node_modules" 1
  for b in node rg; do
    if [ -f "$s/bin/$b" ]; then cp -f "$s/bin/$b" "$P/bin/$b" || _die "swap failed: bin/$b" 1; chmod 755 "$P/bin/$b"; fi
  done
  [ -f "$s/.dsh-engine-version" ] && cp -f "$s/.dsh-engine-version" "$P/.dsh-engine-version"
  [ -f "$P/lib/node_modules/@deepseek-ai/dsh/lib/bin.js" ] || _die "swap produced a broken tree (no dsh bin.js)" 1
  echo "apply: swapped in $(_engine_version)"
}

_swap_back() {
  [ -d "$PREV/node_modules" ] || _die "no rollback available" 1
  rm -rf "$P/lib/node_modules"
  mv "$PREV/node_modules" "$P/lib/node_modules" || _die "rollback failed: cannot restore node_modules" 1
  local b
  for b in node rg; do
    if [ -f "$PREV/bin-$b" ]; then cp -f "$PREV/bin-$b" "$P/bin/$b" && chmod 755 "$P/bin/$b"; fi
  done
  [ -f "$PREV/engine-version" ] && cp -f "$PREV/engine-version" "$P/.dsh-engine-version"
  rm -rf "$PREV"
  echo "rollback: restored previous engine ($(_engine_version))"
}

_cmd_apply() {
  [ -d "$STAGED/lib/node_modules" ] || _die "nothing staged (run: dsh-update pull|stage)" 1
  echo "apply: current dsh=$(_dsh_version) engine=$(_engine_version)"
  local oldpid
  oldpid=$(_engine_pid)
  _swap_in "$STAGED"
  rm -rf "$STAGED"
  _restart_engine
  # 先确认旧引擎确实退了/换了 pid，再判健康，否则 401 的旧引擎会冒充健康
  _wait_restarted 60 "$oldpid" || true
  if _wait_healthy 120; then
    echo "apply: ok (dsh=$(_dsh_version) engine=$(_engine_version))"
    exit 0
  fi
  echo "apply: new engine unhealthy, rolling back" >&2
  _swap_back
  _restart_engine
  _wait_healthy 120 && echo "apply: rolled back (dsh=$(_dsh_version))"
  _EXIT=1 _die "apply failed; rolled back"
}

_cmd_rollback() {
  _swap_back
  _restart_engine
  _wait_healthy 120
  exit 0
}

_cmd_pull() {
  local manifest="$MANIFEST_DEFAULT" apply="" want="" json url sha tmp
  while [ $# -gt 0 ]; do
    case "$1" in
      --manifest) manifest="$2"; shift 2 ;;
      --apply) apply=1; shift ;;
      -*) _usage ;;
      *) want="$1"; shift ;;
    esac
  done
  if [ "$manifest" = "$MANIFEST_DEFAULT" ]; then
    json=$(_feed_manifest) || _die "feed unavailable: no GitHub release with engine-manifest.json yet"
  else
    json=$(_fetch_manifest "$manifest") || _die "manifest fetch failed: $manifest"
  fi
  url=$(_jabi "$json"); sha=$(_jabisha "$json")
  [ -n "$url" ] || _die "no artifact for abi $_ABI in manifest"
  echo "pull: $(_jget "$json" dsh_version) from $url"
  tmp="$P/tmp/engine-dsh.tar.gz"; mkdir -p "$P/tmp"
  curl -fL --retry 3 -m 900 -o "$tmp" "$url" || _die "download failed"
  [ -n "$sha" ] && { [ "$(sha256sum "$tmp" | cut -d' ' -f1)" = "$sha" ] || _die "sha256 mismatch"; }
  "$0" stage "$tmp" "$sha"
  [ -n "$apply" ] && "$0" apply
  echo "pull: staged; run 'dsh-update apply' (or --apply)"
  exit 0
}

case "${1:-status}" in
  status|version) _cmd_status ;;
  check)  shift; _cmd_check "$@" ;;
  pull)   shift; _cmd_pull "$@" ;;
  stage)  shift; _cmd_stage "$@" ;;
  apply)  _cmd_apply ;;
  rollback) _cmd_rollback ;;
  restart) _restart_engine 8000; exit 0 ;;
  howto)  awk '/^# 自己编译上游 dsh/{f=1} /^# 退出码/{f=0} f' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  help|-h|--help) _usage ;;
  *) _die "unknown command: $1 (try dsh-update help)" 2 ;;
esac
