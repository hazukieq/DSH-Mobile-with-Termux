#!/system/bin/sh
# [dsh-android] dsh-update: 热更新 **dsh 引擎层**（不重装 APK、不动 Termux 基础环境）。
#
# 更新范围：lib/node_modules、.dsh-engine-version，以及包内提供的
# lib/dsh-engine/lib、bin/node、bin/rg。版本按 dsh 与引擎标记识别。
# 产物必须预先打好 Android 补丁；上游新版不等于已有可下载的适配包。
#
# 用法:
#   dsh-update status                       本地 dsh/node/引擎版本、暂存与回滚状态
#   dsh-update check [--manifest URL|path]  验证 feed，比较本地与 feed 版本
#   dsh-update pull [dsh-version] [--apply] 下载最新引擎包并暂存（--apply 直接切换）
#   dsh-update stage <url|path> [sha256]    暂存指定引擎包（离线测试用）
#   dsh-update apply                        备份当前引擎 → 换入暂存 → 重启 + 健康检查
#   dsh-update rollback                     回滚到上一份引擎
#   dsh-update restart                      只重启引擎
#   dsh-update version                      同 status
#   dsh-update howto                        打印构建流程与完整文档位置
#
# 自己编译上游 dsh：
#   完整流程见随包文档 ENGINE-BUILD.md §1（手机端见 §1.7）。
#   从选定 tag 构建 → scripts/release/pack.ts --family dsh → 本地 tarball
#   以 file: 依赖装出 consumer/node_modules → bash scripts/build-engine-closure.sh。
#   不要复制 monorepo/node_modules，也不要用 npm 上不完整的 dsh 发布包代替。
#   Android 上先 export TMPDIR="$PREFIX/tmp" 并 mkdir -p "$TMPDIR"。
#   手机自建用独立 npm JS CLI 和锁定的 pnpm JS CLI；不要覆盖 App 的 node。
#   下载依赖时显式指定 registry；安装时禁用 scripts，并单独验收原生能力。
#   本地包：dsh-update stage <tar.gz> <sha256>，核对后 dsh-update apply。
#   自建 feed：构建时传 --download-base <资产目录URL>，上传 tar 与生成的清单，
#   再 DSH_ENGINE_MANIFEST=<清单URL或路径> dsh-update check|pull。
#   APK 发布的溯源 engine-manifest.json 不包含热更新包，不能用作 feed。
#
# 退出码: 0 成功 / 1 失败或被拒 / 2 用法错误 / 3 环境错误
#
# 自举到引擎 bash（同 notify/linux 等门脚本）：shebang 不传环境变量。
if [ -z "$_DSH_REEXEC" ]; then
  _DSH_REEXEC=1; export _DSH_REEXEC
  LD_LIBRARY_PATH="@DSH_LIBDIR@${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"; export LD_LIBRARY_PATH
  exec "@DSH_BASH@" "$0" "$@"
fi

DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
P="${PREFIX:-$(cd "$DIR/.." 2>/dev/null && pwd)}"
STAGED="$P/.engine-staged"
PREV="$P/.engine-prev"
ENGINE_REPO="hazukieq/DSH-Mobile-with-Termux"
MANIFEST_DEFAULT="https://github.com/$ENGINE_REPO/releases/download/dsh-engine-latest/engine-manifest.json"
HEALTH_URL="http://127.0.0.1:3080/"

_die() { echo "dsh-update: $*" >&2; exit "${_EXIT:-3}"; }
_usage() { sed -n '3,/^# 自己编译上游 dsh/p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# ── 版本读取 ────────────────────────────────────────────────────────────────
_dsh_version() {
  local pkg="$P/lib/node_modules/@deepseek-ai/dsh/package.json"
  [ -f "$pkg" ] || { echo "?"; return 1; }
  if [ -x "$P/bin/node" ]; then
    "$P/bin/node" -e 'try{process.stdout.write(require(process.argv[1]).version||"?")}catch(e){process.stdout.write("?")}' "$pkg" 2>/dev/null
  else
    sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$pkg" | head -1
  fi
}
_engine_version() { [ -f "$P/.dsh-engine-version" ] && cat "$P/.dsh-engine-version" || echo "?"; }
_node_version() { [ -x "$P/bin/node" ] && "$P/bin/node" --version 2>/dev/null || echo "?"; }

# ── feed ───────────────────────────────────────────────────────────────────
_ABI=unknown
case "$(uname -m)" in aarch64|arm64) _ABI=aarch64 ;; x86_64|amd64) _ABI=x86_64 ;; arm*) _ABI=arm ;; esac

# Node is part of every engine; parse JSON without depending on formatting or key order.
_json() {
  printf '%s' "$1" | "$P/bin/node" -e '
const fs = require("node:fs");
try {
  const j = JSON.parse(fs.readFileSync(0, "utf8"));
  const [op, abi, key] = process.argv.slice(1);
  if (op === "releases") {
    if (!Array.isArray(j)) throw Error("invalid release list");
    for (const r of j) if (!r.draft) for (const a of r.assets || []) {
      if (["engine-manifest.json", "engine-feed.json"].includes(a.name) &&
          /^https?:\/\//.test(a.browser_download_url || "")) console.log(a.browser_download_url);
    }
  } else if (op === "get") {
    if (typeof j[key] === "string") process.stdout.write(j[key]);
  } else {
    if (j.apk || j.payloads) throw Error("APK provenance manifest is not an engine feed");
    if (j.kind && j.kind !== "dsh-engine-feed") throw Error("unsupported manifest kind");
    if (j.schema_version !== undefined && j.schema_version !== 1) throw Error("unsupported feed schema");
    if (!j.dsh_version || !j.engine_version || typeof j.dsh_version !== "string" ||
        typeof j.engine_version !== "string") throw Error("missing engine/dsh version");
    const asset = j.assets && j.assets[abi];
    if (!asset) throw Error("no artifact for abi " + abi);
    if (!/^https?:\/\//.test(asset.url || "")) throw Error("invalid artifact URL");
    if (!/^[0-9a-f]{64}$/i.test(asset.sha256 || "")) throw Error("missing or invalid sha256");
    if (op === "asset") process.stdout.write(asset[key]);
  }
} catch (e) { console.error("dsh-update: " + e.message); process.exit(1); }
' "$2" "$_ABI" "${3:-}"
}
_jget() { _json "$1" get "$2"; }
_jabi() { _json "$1" asset url; }
_jabisha() { _json "$1" asset sha256; }

_GH_API="https://api.github.com/repos/$ENGINE_REPO"
# 上游 dsh 项目本体（官方 GitHub）：release tag 形如 dsh-v0.2.1-rc.2
_GH_UPSTREAM_API="https://api.github.com/repos/deepseek-ai/deepseek-harness"

# 查上游最新 dsh 版本（只查 GitHub，不查 npm）
_upstream_latest() {
  curl -fsSL -m 25 -H 'Accept: application/vnd.github+json' \
    "$_GH_UPSTREAM_API/releases?per_page=20" 2>/dev/null \
    | tr ',' '\n' \
    | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"dsh-v\([^"]*\)".*/\1/p' \
    | head -1
}

_fetch_manifest() {  # $1=url|path → 内容
  case "$1" in
    http://*|https://*) command -v curl >/dev/null 2>&1 || _die "curl not found"; curl -fsSL --retry 2 -m 60 "$1" ;;
    *) [ -f "$1" ] || _die "manifest not found: $1"; cat "$1" ;;
  esac
}

# Explicit feeds never fall back to a different publisher.
_feed_manifest() {
  local source="${1:-${DSH_ENGINE_MANIFEST:-}}" json url candidates
  if [ -n "$source" ]; then
    json=$(_fetch_manifest "$source") || return 1
    _json "$json" validate || return 1
    printf '%s' "$json"; return 0
  fi
  if json=$(_fetch_manifest "$MANIFEST_DEFAULT" 2>/dev/null) && _json "$json" validate 2>/dev/null; then
    printf '%s' "$json"; return 0
  fi
  json=$(curl -fsSL -m 30 -H 'Accept: application/vnd.github+json' "$_GH_API/releases?per_page=30" 2>/dev/null) || return 1
  candidates=$(_json "$json" releases) || return 1
  while IFS= read -r url; do
    [ -n "$url" ] || continue
    if json=$(_fetch_manifest "$url" 2>/dev/null) && _json "$json" validate 2>/dev/null; then
      printf '%s' "$json"; return 0
    fi
  done <<< "$candidates"
  return 1
}

# ── 引擎层操作 ───────────────────────────────────────────────────────────────
_restart_engine() {
  local delay_ms="${1:-400}"
  # The supervisor restarts the caller too; delay_ms lets the response leave first.
  local helper="$DIR/_dsh_http.sh"
  if [ -r "$helper" ]; then
    # shellcheck disable=SC1090
    . "$helper"
    local body="{\"delayMs\":$delay_ms}"
    if dsh_http POST /engine/restart "$body" >/dev/null 2>&1; then
      if [ "$delay_ms" -gt 0 ]; then
        echo "restart: scheduled via app supervisor in $((delay_ms / 1000))s (current turn will be interrupted)"
        echo "restart: the engine will stop/start by itself; do not run another restart"
      else
        echo "restart: requested via app supervisor (POST /engine/restart)"
      fi
      return 0
    fi
    echo "restart: bridge restart failed; falling back to supervisor-less kill" >&2
  else
    echo "restart: http helper missing ($helper)" >&2
  fi
  pkill -f "$P/bin/node" 2>/dev/null || true
  echo "restart: engine killed; waiting for the app guardian"
}
_engine_pid() {
  pgrep -f "lib/dsh-engine/node-bin" 2>/dev/null | head -1 \
    || pgrep -f "lib/bin.js" 2>/dev/null | head -1 \
    || true
}

# 等「旧引擎真的被换掉」再判健康。
# 为什么需要：受控重启是 App 延迟执行的（_restart_engine 立即返回），如果直接
# _wait_healthy，探测到的还是**旧引擎**的 401，于是新引擎起不来也会被判成 ok，
# 回滚永远不触发。
_wait_restarted() {  # $1=秒 $2=旧 pid
  local limit="$1" old="$2" start=$SECONDS pid
  while [ $((SECONDS - start)) -lt "$limit" ]; do
    pid=$(_engine_pid)
    if [ -z "$pid" ]; then
      echo "restart: engine stopped (was $old), waiting for it to come back"
      return 0
    fi
    if [ -n "$old" ] && [ "$pid" != "$old" ]; then
      echo "restart: engine pid $old -> $pid"
      return 0
    fi
    sleep 1
  done
  echo "restart: engine did not restart within ${limit}s (pid still $old)" >&2
  return 1
}

_wait_healthy() {  # $1=秒
  local limit="$1" start=$SECONDS code
  while [ $((SECONDS - start)) -lt "$limit" ]; do
    code=$(curl -s -o /dev/null -m 3 -w '%{http_code}' "$HEALTH_URL" 2>/dev/null || true)
    case "$code" in 2*|3*|4*) echo "health: ok (http $code)"; return 0 ;; esac
    sleep 2
  done
  echo "health: failed (timeout ${limit}s)" >&2
  return 1
}

_cmd_status() {
  echo "dsh: $(_dsh_version)"
  echo "node: $(_node_version)"
  echo "engine: $(_engine_version)"
  echo "prefix: $P"
  echo "staged: $([ -f "$STAGED/.dsh-engine-version" ] && cat "$STAGED/.dsh-engine-version" || echo none)"
  echo "rollback: $([ -f "$PREV/engine-version" ] && cat "$PREV/engine-version" || echo none)"
  exit 0
}

_cmd_check() {
  local manifest="" json local_v feed_v feed_e local_e up
  while [ $# -gt 0 ]; do
    case "$1" in --manifest) [ $# -ge 2 ] || _usage; manifest="$2"; shift 2 ;; *) _usage ;; esac
  done
  local_v=$(_dsh_version); local_e=$(_engine_version)
  echo "dsh: $local_v"
  echo "engine: $local_e"
  echo "abi: $_ABI"
  if json=$(_feed_manifest "$manifest"); then
    feed_v=$(_jget "$json" dsh_version); feed_e=$(_jget "$json" engine_version)
    echo "feed: ${manifest:-${DSH_ENGINE_MANIFEST:-$MANIFEST_DEFAULT}}"
    echo "feed_dsh: $feed_v"
    echo "feed_engine: $feed_e"
    if [ "$feed_v" = "$local_v" ] && [ "$feed_e" = "$local_e" ]; then
      echo "update: no (already $local_e)"
    else
      echo "update: available ($local_v/$local_e -> $feed_v/$feed_e; version ordering not inferred)"
    fi
    exit 0
  fi
  echo "feed: unavailable (no valid engine feed for $_ABI)"
  echo "update: unknown (no downloadable Android engine verified)"
  echo "hint: APK provenance manifests are not feeds; use DSH_ENGINE_MANIFEST or --manifest with an engine feed."
  [ -z "$manifest${DSH_ENGINE_MANIFEST:-}" ] || exit 1
  up=$(_upstream_latest || true)
  echo "upstream_github: ${up:-unknown} (informational; not an Android update artifact)"
  echo "hint: build a local engine using ENGINE-BUILD.md; no automatic build or publication is implied."
  exit 0
}

_cmd_stage() {
  local src="${1:-}" sha="${2:-}" tmp="$P/tmp/engine-dsh.tar.gz"
  [ -n "$src" ] || _usage
  mkdir -p "$P/tmp"
  case "$src" in
    http://*|https://*) echo "stage: downloading $src"; curl -fL --retry 3 -m 900 -o "$tmp" "$src" || _die "download failed" ;;
    *) [ -f "$src" ] || _die "artifact not found: $src"; [ "$src" -ef "$tmp" ] || cp -f "$src" "$tmp" || _die "copy failed" ;;
  esac
  if [ -n "$sha" ]; then
    local got; got=$(sha256sum "$tmp" | cut -d' ' -f1)
    [ "$got" = "${sha,,}" ] || _die "sha256 mismatch (want $sha got $got)"
  fi
  rm -rf "$STAGED.new"; mkdir -p "$STAGED.new"
  tar -xzf "$tmp" -C "$STAGED.new" || _die "extract failed"
  [ -f "$STAGED.new/lib/node_modules/@deepseek-ai/dsh/lib/bin.js" ] || _die "artifact is not a dsh engine bundle"
  [ -s "$STAGED.new/.dsh-engine-version" ] || _die "artifact has no engine version"
  # Native libraries, when supplied, must travel with the JS closure.
  if [ -d "$STAGED.new/lib/dsh-engine/lib" ]; then
    echo "stage: native libs: $(ls "$STAGED.new/lib/dsh-engine/lib" | wc -l) files"
  fi
  rm -rf "$STAGED"; mv "$STAGED.new" "$STAGED"
  echo "stage: ok ($([ -f "$STAGED/.dsh-engine-version" ] && cat "$STAGED/.dsh-engine-version" || echo unknown))"
  exit 0
}

_swap_in() {  # $1 = staged 目录（引擎层）
  local s="$1" b
  rm -rf "$PREV"; mkdir -p "$PREV"
  # 备份旧的引擎层（每项独立，缺就跳过；用 cp 而不是 mv，避免目录嵌套时静默出错）
  [ -d "$P/lib/node_modules" ] && { mv "$P/lib/node_modules" "$PREV/node_modules" || _die "backup of node_modules failed (out of space?)" 1; }
  for b in node rg; do [ -f "$P/bin/$b" ] && cp -f "$P/bin/$b" "$PREV/bin-$b"; done
  [ -f "$P/.dsh-engine-version" ] && cp -f "$P/.dsh-engine-version" "$PREV/engine-version"
  # 原生库目录（lib/dsh-engine/lib）：整目录替换，旧的一份 mv 进 PREV 供回滚。
  # 目录可能很大（vips 闭包 ~69 个 .so / 40MB），用 mv 而非 cp，避免双倍占用。
  local native=0
  if [ -d "$s/lib/dsh-engine/lib" ]; then
    [ -d "$P/lib/dsh-engine/lib" ] && { mv "$P/lib/dsh-engine/lib" "$PREV/engine-lib" || _die "backup of engine lib failed (out of space?)" 1; }
    mkdir -p "$P/lib/dsh-engine"
    mv "$s/lib/dsh-engine/lib" "$P/lib/dsh-engine/lib" || _die "swap failed: cannot move staged engine lib" 1
    native=$(ls "$P/lib/dsh-engine/lib" | wc -l)
  fi
  # 换入新层（旧层已 mv 到 PREV，这里目标必然不存在）
  rm -rf "$P/lib/node_modules"
  mv "$s/lib/node_modules" "$P/lib/node_modules" || _die "swap failed: cannot move staged node_modules" 1
  for b in node rg; do
    if [ -f "$s/bin/$b" ]; then cp -f "$s/bin/$b" "$P/bin/$b" || _die "swap failed: bin/$b" 1; chmod 755 "$P/bin/$b"; fi
  done
  [ -f "$s/.dsh-engine-version" ] && cp -f "$s/.dsh-engine-version" "$P/.dsh-engine-version"
  [ -f "$P/lib/node_modules/@deepseek-ai/dsh/lib/bin.js" ] || _die "swap produced a broken tree (no dsh bin.js)" 1
  [ "$native" -gt 0 ] && echo "apply: native libs: $native files"
  echo "apply: swapped in $(_engine_version)"
}

_swap_back() {
  [ -d "$PREV/node_modules" ] || _die "no rollback available" 1
  rm -rf "$P/lib/node_modules"
  mv "$PREV/node_modules" "$P/lib/node_modules" || _die "rollback failed: cannot restore node_modules" 1
  local b
  for b in node rg; do
    if [ -f "$PREV/bin-$b" ]; then cp -f "$PREV/bin-$b" "$P/bin/$b" && chmod 755 "$P/bin/$b"; fi
  done
  if [ -d "$PREV/engine-lib" ]; then
    rm -rf "$P/lib/dsh-engine/lib"
    mv "$PREV/engine-lib" "$P/lib/dsh-engine/lib" || _die "rollback failed: cannot restore engine lib" 1
    echo "rollback: native libs: $(ls "$P/lib/dsh-engine/lib" | wc -l) files"
  fi
  [ -f "$PREV/engine-version" ] && cp -f "$PREV/engine-version" "$P/.dsh-engine-version"
  rm -rf "$PREV"
  echo "rollback: restored previous engine ($(_engine_version))"
}

_cmd_apply() {
  [ -d "$STAGED/lib/node_modules" ] || _die "nothing staged (run: dsh-update pull|stage)" 1
  echo "apply: current dsh=$(_dsh_version) engine=$(_engine_version)"
  local oldpid
  oldpid=$(_engine_pid)
  _swap_in "$STAGED"
  rm -rf "$STAGED"
  _restart_engine
  # 先确认旧引擎确实退了/换了 pid，再判健康，否则 401 的旧引擎会冒充健康
  _wait_restarted 60 "$oldpid" || true
  if _wait_healthy 120; then
    echo "apply: ok (dsh=$(_dsh_version) engine=$(_engine_version))"
    exit 0
  fi
  echo "apply: new engine unhealthy, rolling back" >&2
  _swap_back
  _restart_engine
  _wait_healthy 120 && echo "apply: rolled back (dsh=$(_dsh_version))"
  _EXIT=1 _die "apply failed; rolled back"
}

_cmd_rollback() {
  _swap_back
  _restart_engine
  _wait_healthy 120
  exit 0
}

_cmd_pull() {
  local manifest="" apply="" want="" json url sha tmp
  while [ $# -gt 0 ]; do
    case "$1" in
      --manifest) [ $# -ge 2 ] || _usage; manifest="$2"; shift 2 ;;
      --apply) apply=1; shift ;;
      -*) _usage ;;
      *) [ -z "$want" ] || _usage; want="$1"; shift ;;
    esac
  done
  json=$(_feed_manifest "$manifest") || _die "feed unavailable: supply a valid engine feed via --manifest or DSH_ENGINE_MANIFEST"
  if [ -n "$want" ] && [ "$want" != "$(_jget "$json" dsh_version)" ] && [ "$want" != "$(_jget "$json" engine_version)" ]; then
    _die "requested version $want does not match feed"
  fi
  url=$(_jabi "$json"); sha=$(_jabisha "$json")
  echo "pull: $(_jget "$json" dsh_version) from $url"
  tmp="$P/tmp/engine-dsh.tar.gz"; mkdir -p "$P/tmp"
  curl -fL --retry 3 -m 900 -o "$tmp" "$url" || _die "download failed"
  "$BASH" "$0" stage "$tmp" "$sha" || _die "staging failed"
  if [ -n "$apply" ]; then
    "$BASH" "$0" apply || return $?
  else
    echo "pull: staged; run dsh-update apply"
  fi
}

case "${1:-status}" in
  status|version) _cmd_status ;;
  check)  shift; _cmd_check "$@" ;;
  pull)   shift; _cmd_pull "$@" ;;
  stage)  shift; _cmd_stage "$@" ;;
  apply)  _cmd_apply ;;
  rollback) _cmd_rollback ;;
  restart) _restart_engine 8000; exit 0 ;;
  howto)  awk '/^# 自己编译上游 dsh/{f=1} /^# 退出码/{f=0} f' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  help|-h|--help) _usage ;;
  *) _die "unknown command: $1 (try dsh-update help)" 2 ;;
esac
