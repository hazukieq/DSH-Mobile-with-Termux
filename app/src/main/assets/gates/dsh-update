#!/system/bin/sh
# [dsh-android] dsh-update: 查看/更新 dsh 引擎版本。
#
# 2026-10-18 起引擎是**随 APK 打包的适配版运行时**（Termux 里 npm 装不了 dsh）。
# 所以这里不去动 npm：pull 只是提示，真正升级 = 装新 APK。
#
# 用法:
#   dsh-update status           当前 dsh / node 版本
#   dsh-update check            期望的引擎标记
#   dsh-update pull [version]   提示如何升级（内置引擎不可 npm 覆盖）
#   dsh-update restart          杀掉引擎 node，App 守护会自动拉起
if [ -z "$_DSH_REEXEC" ]; then
  _DSH_REEXEC=1; export _DSH_REEXEC
  exec "@DSH_BASH@" "$0" "$@"
fi
PREFIX_DIR="$(cd "$(dirname "$0")/.." && pwd)"
NODE="$PREFIX_DIR/bin/node"
case "${1:-status}" in
  status)
    echo "dsh:  $("$NODE" -e 'try{process.stdout.write(require(process.argv[1]).version)}catch(e){process.stdout.write("?")}' "$PREFIX_DIR/lib/node_modules/@deepseek-ai/dsh/package.json" 2>/dev/null)"
    echo "node: $("$NODE" --version 2>/dev/null)"
    [ -f "$PREFIX_DIR/.dsh-engine-version" ] && echo "engine: $(cat "$PREFIX_DIR/.dsh-engine-version")"
    ;;
  check) cat "$PREFIX_DIR/.dsh-engine-version" 2>/dev/null ;;
  pull)
    echo "dsh-update: 引擎随 APK 打包（适配版），不能用 npm 覆盖。"
    echo "            升级方式：安装包含新引擎的 APK；旧的自制 runtime feed 已停用。"
    exit 0
    ;;
  restart)
    pkill -f "$PREFIX_DIR/bin/node" 2>/dev/null
    echo "dsh-update: engine killed; the app guardian will start it again"
    ;;
  *) echo "usage: dsh-update status|check|pull|restart" >&2; exit 2 ;;
esac
