<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 状态悬浮窗（v1.2.58 初版；v1.3.75 展开卡片 + 实时滚动）

  形态：
    ① 折叠态 —— 圆形状态点（26dp 球），不打扰
    ② 展开态 —— 点击后变成圆角卡片，四段式：
         思考链 → 工具链 → 无障碍/打开应用动作链 → 会话标题 + 倒计时

  展开内容用 ScrollView 包住：后台思考文本可能很长，折行显示并自动滚到最新一行；
  动作行/标题过长时用跑马灯（marquee）滚动。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_overlay_panel"
    android:paddingStart="10dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:minWidth="0dp"
    android:elevation="0dp">

    <!-- 状态行：圆点 + 可滚动内容 + 麦克风（折叠态只显示圆点） -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <View
            android:id="@+id/overlayDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="7dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_overlay_dot" />

        <ScrollView
            android:id="@+id/overlayScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="216dp"
            android:maxHeight="132dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:overScrollMode="never">

            <TextView
                android:id="@+id/overlayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="216dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="2dp"
                android:textColor="#FFE8EAED"
                android:text="DSH" />
        </ScrollView>

    </LinearLayout>

    <!-- 动作链（v2.5.5）：最近几条工具动作，多行显示；不再和思考链挤在同一段文字里 -->
    <TextView
        android:id="@+id/overlayAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginStart="16dp"
        android:maxWidth="216dp"
        android:textSize="10.5sp"
        android:textColor="#FF9AA0A6"
        android:lineSpacingExtra="1dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <!-- 无障碍 / 自动化 / 打开应用动作链（v2.5.6）：和工具链同样式，紧贴其下一行。
         只显示「无障碍服务真正做的事」——读屏点击/滑动/按键、启动或跳转别的 App。 -->
    <TextView
        android:id="@+id/overlayA11y"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginStart="16dp"
        android:maxWidth="216dp"
        android:textSize="10.5sp"
        android:textColor="#FF9AA0A6"
        android:lineSpacingExtra="1dp"
        android:maxLines="4"
        android:ellipsize="end"
        android:visibility="gone"
        android:text="" />

    <!-- 会话标题 + 倒计时（v2.5.5）：展开时单独一行，标题被省略而不是被秒数挤掉 -->
    <LinearLayout
        android:id="@+id/overlayFoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp"
        android:layout_marginStart="16dp"
        android:maxWidth="216dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/overlaySession"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxWidth="180dp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:textSize="11sp"
            android:textColor="#FF9AA0A6"
            android:text="" />

        <TextView
            android:id="@+id/overlayElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:singleLine="true"
            android:textSize="11sp"
            android:textColor="#FF7DD3FC"
            android:text="" />
    </LinearLayout>

</LinearLayout>
