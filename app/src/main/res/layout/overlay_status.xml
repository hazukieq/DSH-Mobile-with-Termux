<?xml version="1.0" encoding="utf-8"?>
<!--
  悬浮窗布局（2026-11 重写版）：一个文件描述两种形态。
  · 折叠态：只显示 overlayBallDot，窗口由 applyWindowSize() 固定成正方形。
  · 展开态：overlayRow = [dot] + [可滚动文字]；空闲时滚动区贴合文字，工作时固定 92dp。
  尺寸一律 wrap_content，窗口大小由 StatusOverlay.applyWindowSize() 决定，本文件不再写死宽度。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_overlay_panel"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp"
    android:minWidth="0dp"
    android:elevation="0dp">

    <!-- 球态圆点：只挂在根上、layout_gravity=center，折叠时可见 -->
    <View
        android:id="@+id/overlayBallDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:background="@drawable/bg_overlay_dot" />

    <!-- 展开态一行：圆点 + 文字（文字包在 ScrollView 里，长内容在框内滚动） -->
    <LinearLayout
        android:id="@+id/overlayRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <!-- 占位：历史代码里 overlayDot 被用于绑定手势/配色；图标已改由 TextView.drawableStart 提供，
             这里保留 0dp 占位以免破坏 R.id 引用（不可见、不参与布局）。 -->
        <View
            android:id="@+id/overlayDot"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <ScrollView
            android:id="@+id/overlayScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:maxWidth="216dp"
            android:scrollbars="vertical"
            android:overScrollMode="never">

            <TextView
                android:id="@+id/overlayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:textColor="#E6EAF2"
                android:drawableStart="@drawable/bg_overlay_dot"
                android:drawablePadding="6dp"
                android:maxWidth="216dp" />
        </ScrollView>
    </LinearLayout>

    <!-- 无障碍分类行（仅工作态显示） -->
    <TextView
        android:id="@+id/overlayA11y"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#8FA0B8"
        android:visibility="gone" />

    <!-- 底部行：会话标题 + 耗时（仅工作态显示） -->
    <LinearLayout
        android:id="@+id/overlayFoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/overlaySession"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#8FA0B8" />

        <TextView
            android:id="@+id/overlayElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#8FA0B8" />
    </LinearLayout>
</LinearLayout>
