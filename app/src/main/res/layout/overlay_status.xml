<?xml version="1.0" encoding="utf-8"?>
<!-- 折叠球与展开卡片共用布局；StatusOverlay 控制窗口尺寸与固定 92dp 正文高度。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_overlay_panel"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp"
    android:minWidth="0dp"
    android:elevation="0dp">

    <!-- 球态圆点：只挂在根上、layout_gravity=center，折叠时可见 -->
    <View
        android:id="@+id/overlayBallDot"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_gravity="center"
        android:visibility="gone"
        android:background="@drawable/bg_overlay_dot" />

    <!-- 展开态一行：圆点 + 文字（文字包在 ScrollView 里，长内容在框内滚动） -->
    <LinearLayout
        android:id="@+id/overlayRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">
        <!-- 图标固定在这里（不放进 ScrollView），随卡片静止；topMargin 让它的中线落到首行文字的中线 -->
        <View
            android:id="@+id/overlayDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="top"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_overlay_dot" />

        <ScrollView
            android:id="@+id/overlayScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:scrollbars="vertical"
            android:overScrollMode="never">

            <TextView
                android:id="@+id/overlayStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:includeFontPadding="false"
                android:textColor="#E6EAF2" />
        </ScrollView>
    </LinearLayout>

    <!-- 动作行：展开且有内容时显示 -->
    <TextView
        android:id="@+id/overlayA11y"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textSize="11sp"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="#8FA0B8"
        android:visibility="gone" />

    <!-- 底部行：展开时显示会话标题与耗时 -->
    <LinearLayout
        android:id="@+id/overlayFoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/overlaySession"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="#8FA0B8" />

        <TextView
            android:id="@+id/overlayElapsed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#8FA0B8" />
    </LinearLayout>
</LinearLayout>
