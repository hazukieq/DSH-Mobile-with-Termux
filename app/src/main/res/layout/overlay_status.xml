<?xml version="1.0" encoding="utf-8"?>
<!--
  AI 状态悬浮窗（v1.2.58 初版；v1.3.75 展开卡片 + 实时滚动）

  形态：
    ① 折叠态 —— 圆形状态点（26dp 球），不打扰
    ② 展开态 —— 点击后变成圆角卡片：状态点 + 可滚动的实时内容 + 麦克风
    ③ 详情态 —— 卡片追加最近动作与会话列表

  展开内容用 ScrollView 包住：后台思考文本可能很长，折行显示并自动滚到最新一行；
  动作行/标题过长时用跑马灯（marquee）滚动。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_overlay_panel"
    android:paddingStart="10dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:minWidth="0dp"
    android:elevation="0dp">

    <!-- 状态行：圆点 + 可滚动内容 + 麦克风（折叠态只显示圆点） -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <View
            android:id="@+id/overlayDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="7dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/bg_overlay_dot" />

        <ScrollView
            android:id="@+id/overlayScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="232dp"
            android:maxHeight="176dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:overScrollMode="never">

            <TextView
                android:id="@+id/overlayStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="232dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="2dp"
                android:textColor="#FFE8EAED"
                android:text="DSH" />
        </ScrollView>

        <ImageView
            android:id="@+id/overlayMic"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:padding="3dp"
            android:src="@drawable/ic_mic"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/a11y_voice_input"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- 动作行：标题/最近动作；过长跑马灯滚动 -->
    <TextView
        android:id="@+id/overlayAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:maxWidth="232dp"
        android:textSize="11sp"
        android:textColor="#FF9AA0A6"
        android:singleLine="true"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:visibility="gone"
        android:text="" />

    <!-- 详情态：活跃会话列表（容器由代码填充） -->
    <LinearLayout
        android:id="@+id/overlaySessions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        android:visibility="gone" />
</LinearLayout>
