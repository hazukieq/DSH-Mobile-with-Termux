<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面（v1.3.0 第二轮：原生 App 布局）
     结构：竖排 [固定 56dp 顶栏] + [WebView 内容区]；抽屉/遮罩/splash 在根层叠放。
     - 顶栏：[☰] 标题 [⋮]，旧的 重启/隐藏/设置 收进 ⋮ popup
     - 抽屉：原生 LinearLayout 面板 + 半透明遮罩，条目用 JS 驱动 WebUI
     - WebView 不再被工具栏遮盖：工具栏占布局空间，页面从它下方开始 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- ==================== 固定顶栏 ==================== -->
        <LinearLayout
            android:id="@+id/statusBarRow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="#FF15191F"
            android:elevation="6dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnDrawer"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="\u2630"
                android:textColor="#FFE5E9F0"
                android:textSize="22sp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/btn_drawer" />

            <TextView
                android:id="@+id/statusBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingHorizontal="4dp"
                android:textColor="#FF9CA3AF"
                android:textSize="13sp"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/topTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingHorizontal="6dp"
                android:textColor="#FFF2F5F9"
                android:textSize="17sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:text="@string/app_name" />

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/btn_back"
                android:textColor="#FF6EE7B7"
                android:textSize="13sp"
                android:visibility="gone"
                android:background="?android:attr/selectableItemBackground" />

            <!-- 旧入口：代码仍引用，收进 ⋮ 菜单后隐藏 -->
            <TextView
                android:id="@+id/btnRestart"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnHide"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnMore"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:contentDescription="@string/settings_title" />

            <TextView
                android:id="@+id/btnOverflow"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="\u22ee"
                android:textColor="#FFE5E9F0"
                android:textSize="22sp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/btn_more_menu" />
        </LinearLayout>

        <!-- ==================== 网页内容区 ==================== -->
        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/webView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/installProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="3dp"
                android:maxHeight="3dp"
                android:layout_gravity="top"
                android:indeterminate="true"
                android:progressTint="#FF7DD3FC"
                android:progressBackgroundTint="#26FFFFFF"
                android:elevation="4dp"
                android:visibility="gone" />

            <!-- 顶栏隐藏后的唤回把手 -->
            <LinearLayout
                android:id="@+id/handleBar"
                android:layout_width="64dp"
                android:layout_height="16dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_handle_bar"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">
                <View
                    android:layout_width="28dp"
                    android:layout_height="3dp"
                    android:background="#99FFFFFF" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ==================== 抽屉遮罩 + 面板 ==================== -->
    <View
        android:id="@+id/drawerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/drawerPanel"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#FF15191F"
        android:elevation="24dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:visibility="invisible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="10dp"
            android:text="@string/app_name"
            android:textColor="#FFF2F5F9"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/drawerNew"
            style="@style/DrawerItem"
            android:text="@string/drawer_new_session" />

        <TextView
            android:id="@+id/drawerPlugins"
            style="@style/DrawerItem"
            android:text="@string/drawer_plugins" />

        <TextView
            android:id="@+id/drawerAutomation"
            style="@style/DrawerItem"
            android:text="@string/drawer_automation" />

        <TextView
            android:id="@+id/drawerMemory"
            style="@style/DrawerItem"
            android:text="@string/drawer_memory" />

        <TextView
            android:id="@+id/drawerSearch"
            style="@style/DrawerItem"
            android:text="@string/drawer_search" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:layout_marginHorizontal="20dp"
            android:background="#22FFFFFF" />

        <!-- dsh 自己的设置（引擎设置弹窗）；原生设置只在 ⋮ 菜单里 -->
        <TextView
            android:id="@+id/drawerDshSettings"
            style="@style/DrawerItem"
            android:text="@string/drawer_dsh_settings" />
    </LinearLayout>

    <!-- ==================== 启动动画（v1.3.1） ====================
         冷启动时运行时解压 + 引擎启动需要时间，之前这段时间是一块空黑屏（用户反馈）。
         这里用一层品牌遮罩盖住：logo 淡入 + 轻微呼吸、真实解压百分比、
         状态文案随引擎阶段变化；WebView 首屏加载完成后淡出。
         clickable/focusable：遮罩期间吞掉误触，避免用户点到下面还没就绪的界面。 -->
    <LinearLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FF101418"
        android:elevation="30dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/app_name"
            android:textColor="#FFF2F5F9"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/splashStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/splash_preparing"
            android:textColor="#FF9CA3AF"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/splashProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="180dp"
            android:layout_height="3dp"
            android:layout_marginTop="22dp"
            android:indeterminate="true"
            android:progressTint="#FF7DD3FC"
            android:progressBackgroundTint="#26FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/splash_hint"
            android:textColor="#FF5A6472"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>

</FrameLayout>
